{
  "name": "openspec-studio",
  "version": "0.2.0",
  "description": "Review OpenSpec changes like a Google Doc, then let your AI coding agent (Claude Code, Codex, CodeBuddy) build them. A local web app.",
  "keywords": [
    "openspec",
    "spec-driven-development",
    "ai",
    "agent",
    "claude-code",
    "codex",
    "acp",
    "code-review",
    "specs"
  ],
  "homepage": "https://github.com/baabullah/openspec-studio#readme",
  "bugs": {
    "url": "https://github.com/baabullah/openspec-studio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baabullah/openspec-studio.git"
  },
  "license": "MIT",
  "author": "baabullah",
  "type": "module",
  "bin": {
    "openspec-studio": "bin/openspec-studio.mjs"
  },
  "files": [
    "bin/",
    "server/src/",
    "shared/",
    "web/dist/",
    "scripts/demo-repo.mjs"
  ],
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm -w web run build",
    "start": "npm -w server run start",
    "test": "npm -w server run test && npm -w web run test",
    "typecheck": "npm -w server run typecheck && npm -w web run typecheck",
    "lint": "biome lint .",
    "demo-repo": "node scripts/demo-repo.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.4.0",
    "@hono/node-server": "^2.1.6",
    "chokidar": "^6.0.0",
    "cross-spawn": "^7.0.6",
    "diff": "^9.0.0",
    "hono": "^4.13.16",
    "ws": "^8.22.1",
    "zod": "^4.6.7",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6"
  }
}
